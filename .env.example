# Copy to .env. One Groq key runs the whole stack (Whisper STT, Llama LLM, TTS).
GROQ_API_KEY=

# Provider selection (see the env table in the README)
LLM_PROVIDER=groq        # groq | openai | ollama
STT_PROVIDER=groq        # groq | openai | deepgram
TTS_PROVIDER=groq        # groq | openai | cartesia
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional overrides of the model names in config/voicedesk.yaml (also LLM_BASE_URL, LLM_API_KEY)
LLM_MODEL=
STT_MODEL=
TTS_MODEL=
TTS_VOICE=
# TURN_DETECTION=model uses the LiveKit turn-detector model, "vad" uses VAD only
TURN_DETECTION=model

# LiveKit (self-hosted dev server from docker-compose.yml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Services
DATABASE_URL=postgresql://voicedesk:voicedesk@localhost:5434/voicedesk
BOOKING_GRPC_ADDR=localhost:50051
